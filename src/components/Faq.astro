---
import { FAQS, SITE_CONFIG } from '../config/site';

const contactCards = [
  {
    icon: "whatsapp",
    title: "WhatsApp Directo",
    text: "Escríbenos para consultas rápidas sobre productos, stock o tu número de envío.",
    btnText: "Escribir a WhatsApp",
    btnColor: "bg-[#25d366] hover:bg-[#20ba5a] text-white",
    url: `https://wa.me/${SITE_CONFIG.whatsAppNumber.replace('+', '')}?text=${encodeURIComponent(SITE_CONFIG.whatsAppMessage)}`
  },
  {
    icon: "instagram",
    title: "Instagram",
    text: "Síguenos para conocer nuevos lanzamientos, ilustraciones de aves y fotos en terreno.",
    btnText: "Ir a Instagram",
    btnColor: "bg-gradient-to-r from-[#833ab4] via-[#fd1d1d] to-[#fcb045] hover:opacity-90 text-white",
    url: SITE_CONFIG.instagramUrl
  },
  {
    icon: "email",
    title: "Correo Electrónico",
    text: `Escríbenos a ${SITE_CONFIG.email} para consultas generales, alianzas o institucionales.`,
    btnText: "Enviar Correo",
    btnColor: "bg-[#34495e] hover:bg-[#2c3e50] text-white",
    url: `mailto:${SITE_CONFIG.email}`
  }
];
---

<section id="faq" class="py-16 sm:py-20 relative border-t border-[#2b4f25]/10">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <span class="inline-block px-4 py-1.5 rounded-full bg-[#d8e4cb] text-[#2b4f25] font-extrabold text-xs uppercase tracking-widest border border-[#2b4f25]/20 shadow-xs">
        Atención al Lepigamer
      </span>
      <h2 class="text-3xl sm:text-5xl font-serif font-bold text-[#1b3519] tracking-tight uppercase">
        Hablemos :)
      </h2>
      <div class="inline-block bg-white/90 backdrop-blur-md px-6 sm:px-8 py-3.5 rounded-2xl border border-[#2b4f25]/20 shadow-md">
        <p class="text-sm sm:text-base text-[#1b3519] font-serif leading-relaxed">
          ¿Tienes alguna duda sobre nosotros, despacho o medio de pago?<br/>Estamos para ayudarte.
        </p>
      </div>
    </div>

    <!-- Contact Action Cards (Larger & Prominent) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8 max-w-6xl mx-auto">
      {contactCards.map((contact) => (
        <div class="bg-white/95 backdrop-blur-md p-7 sm:p-8 rounded-3xl border border-[#2b4f25]/20 shadow-lg hover:shadow-xl transition-all flex flex-col justify-between space-y-6 text-center">
          <div class="space-y-3">
            <h3 class="font-bold text-xl sm:text-2xl text-[#1b3519] font-serif">{contact.title}</h3>
            <p class="text-sm text-gray-700 leading-relaxed max-w-xs mx-auto font-sans">{contact.text}</p>
          </div>
          
          <div class="pt-2">
            <a
              href={contact.url}
              target="_blank"
              rel="noopener noreferrer"
              class={`w-full inline-flex items-center justify-center gap-2 font-extrabold text-sm sm:text-base py-3.5 px-5 rounded-2xl shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5 ${contact.btnColor}`}
            >
              <span>{contact.btnText}</span>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Collapsible Space-Saving FAQ Accordion Master Panel -->
    <div class="pt-6 border-t border-[#2b4f25]/15 max-w-4xl mx-auto">
      <details class="group bg-white/95 rounded-3xl border-2 border-[#2b4f25]/20 shadow-lg overflow-hidden transition-all duration-300">
        <summary class="flex items-center justify-between p-6 sm:p-7 cursor-pointer select-none bg-gradient-to-r from-emerald-50/80 via-white to-amber-50/50 hover:bg-emerald-100/40 transition-colors">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-2xl bg-[#35592f] text-white flex items-center justify-center font-extrabold text-xl shadow-md shrink-0">
              ?
            </div>
            <div class="text-left">
              <h3 class="font-serif font-bold text-lg sm:text-2xl text-[#1b3519] leading-tight">
                Ver Preguntas Frecuentes Detalladas
              </h3>
              <p class="text-xs sm:text-sm text-[#1b3519]/70 font-serif mt-0.5">
                Haz clic aquí para desplegar u ocultar respuestas sobre envíos, medio de pago y stock.
              </p>
            </div>
          </div>
          
          <!-- Animated Down Arrow Button -->
          <div class="w-10 h-10 rounded-full bg-white border border-[#2b4f25]/25 text-[#2b4f25] flex items-center justify-center shadow-sm group-open:rotate-180 transition-transform duration-300 shrink-0 ml-3">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
            </svg>
          </div>
        </summary>

        <!-- Inner Content: List of detailed FAQ items -->
        <div class="p-5 sm:p-7 space-y-3.5 border-t border-[#2b4f25]/15 bg-slate-50/50">
          {FAQS.map((faq) => (
            <details class="group/faq bg-white rounded-2xl border border-[#2b4f25]/15 shadow-xs overflow-hidden transition-all">
              <summary class="flex items-center justify-between p-4 sm:p-5 cursor-pointer select-none text-left">
                <h4 class="text-sm sm:text-base font-bold text-[#1b3519] pr-4 group-hover/faq:text-[#2b4f25] transition-colors">
                  {faq.question}
                </h4>
                <div class="shrink-0 w-7 h-7 rounded-full bg-[#e5ebd9] text-[#2b4f25] flex items-center justify-center group-open/faq:rotate-180 transition-transform duration-300">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
                  </svg>
                </div>
              </summary>
              <div class="px-4 sm:px-5 pb-5 pt-1 text-xs sm:text-sm text-[#1b3519]/85 font-serif leading-relaxed border-t border-gray-100">
                {faq.answer}
              </div>
            </details>
          ))}
        </div>
      </details>
    </div>

  </div>
</section>
