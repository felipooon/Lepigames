---
import { Image } from 'astro:assets';
import { BIRD_SPECIES } from '../config/site';

// Import all bird images dynamically using Vite's glob import
const birdImagesConFondo = import.meta.glob<{ default: ImageMetadata }>('../assets/birds/con-fondo/*.png');
const birdImagesSinFondo = import.meta.glob<{ default: ImageMetadata }>('../assets/birds/sin-fondo/*.png');

// Build array combining species data with both image loaders
const speciesList = await Promise.all(
  BIRD_SPECIES.map(async (bird) => {
    const cfPath = `../assets/birds/con-fondo/${bird.slug}.png`;
    const sfPath = `../assets/birds/sin-fondo/${bird.slug}.png`;
    
    const cfLoader = birdImagesConFondo[cfPath];
    const sfLoader = birdImagesSinFondo[sfPath];

    const cfModule = cfLoader ? await cfLoader() : null;
    const sfModule = sfLoader ? await sfLoader() : null;

    return {
      ...bird,
      imageConFondo: cfModule ? cfModule.default : null,
      imageSinFondo: sfModule ? sfModule.default : null,
    };
  })
);
---

<section id="especies" class="py-16 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Prototype Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-10">
      <h2 class="text-3xl sm:text-5xl font-serif font-bold text-[#1b3519] tracking-tight uppercase">
        Conoce a las especies protagonistas
      </h2>
      <div class="inline-block bg-white/85 backdrop-blur-md px-6 py-3.5 rounded-2xl border border-[#2b4f25]/20 shadow-md">
        <p class="text-sm sm:text-base text-[#1b3519] font-serif leading-relaxed">
          Haz clic sobre cualquiera de las 31 aves para desplegar la ilustración ampliada y conocer más sobre su hábitat.
        </p>
      </div>
    </div>

    <!-- 31 Species Grid matching PDF Layout -->
    <div id="species-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-6 sm:gap-8">
      {speciesList.map((bird) => (
        <button
          type="button"
          class="species-card group text-center flex flex-col items-center justify-between p-3 rounded-2xl bg-white/60 hover:bg-white border border-[#2b4f25]/10 hover:border-[#2b4f25]/30 shadow-xs hover:shadow-lg transition-all transform hover:-translate-y-1 cursor-pointer focus:outline-none"
          data-slug={bird.slug}
          data-name={bird.name}
          data-scientific={bird.scientificName}
          data-family={bird.family}
          data-tag={bird.tag || ''}
          data-description={bird.description || ''}
          data-img-src={bird.imageConFondo ? bird.imageConFondo.src : ''}
        >
          <!-- Bird Illustration Container (Using sin-fondo / transparent PNG as PDF prototype) -->
          <div class="relative w-full aspect-square flex items-center justify-center p-2 mb-2 bg-transparent">
            {bird.imageSinFondo ? (
              <Image
                src={bird.imageSinFondo}
                alt={`Ilustración de ${bird.name}`}
                class="max-h-36 w-auto object-contain group-hover:scale-110 transition-transform duration-300 drop-shadow-md"
                width={250}
                height={250}
              />
            ) : bird.imageConFondo ? (
              <Image
                src={bird.imageConFondo}
                alt={`Ilustración de ${bird.name}`}
                class="max-h-36 w-auto object-contain group-hover:scale-105 transition-transform duration-300"
                width={250}
                height={250}
              />
            ) : (
              <span class="text-xs text-[#2b4f25]">Sin imagen</span>
            )}
          </div>

          <!-- Bird Titles -->
          <div class="w-full text-center">
            <h3 class="font-sans font-semibold text-xs sm:text-sm text-[#2b4f25] leading-tight group-hover:text-emerald-700 transition-colors">
              {bird.name}
            </h3>
            <p class="text-[11px] font-serif italic text-[#1b3519]/70 truncate mt-0.5">
              {bird.scientificName}
            </p>
          </div>
        </button>
      ))}
    </div>

  </div>

  <!-- Interactive Lightbox Modal -->
  <div
    id="bird-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/80 backdrop-blur-sm transition-opacity overflow-y-auto"
    role="dialog"
    aria-modal="true"
  >
    <div class="relative bg-white rounded-3xl max-w-lg w-full p-5 sm:p-7 pb-7 sm:pb-8 shadow-2xl border border-emerald-900/20 transform transition-all scale-95 opacity-0 modal-content my-auto max-h-[90vh] flex flex-col overflow-y-auto">
      
      <!-- Close Button (Top Right X) -->
      <button
        id="modal-close"
        type="button"
        class="absolute top-3 right-3 sm:top-4 sm:right-4 p-2.5 rounded-full text-gray-500 hover:text-gray-900 bg-gray-100/80 hover:bg-gray-200 transition-colors z-20 shadow-xs"
        aria-label="Cerrar modal"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>

      <!-- Modal Content -->
      <div class="text-center flex flex-col h-full">
        <!-- Enlarged Image - Full & Prominent display -->
        <div class="relative w-full max-w-sm sm:max-w-md mx-auto h-52 sm:h-64 md:h-72 rounded-2xl overflow-hidden bg-[#e5ebd9]/60 border border-emerald-900/10 shadow-md mb-4 flex items-center justify-center shrink-0">
          <img id="modal-img" src="" alt="" class="w-full h-full object-contain p-2 sm:p-3" />
        </div>

        <div class="shrink-0 mb-3">
          <span id="modal-tag" class="inline-block px-3 py-1 rounded-full bg-[#35592f] text-white font-bold text-xs uppercase tracking-wider mb-2"></span>
          <h3 id="modal-title" class="text-2xl sm:text-3xl font-serif font-bold text-[#1b3519] leading-tight"></h3>
          <p id="modal-scientific" class="text-sm sm:text-base italic font-serif text-[#2b4f25] mb-0.5"></p>
          <p id="modal-family" class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1"></p>
        </div>

        <!-- Species Description Card -->
        <div class="bg-[#85a67c]/15 border border-[#85a67c]/30 rounded-2xl p-4 text-left mb-4 shadow-xs max-h-40 sm:max-h-48 overflow-y-auto shrink">
          <h4 class="text-xs font-bold uppercase tracking-wider text-[#2b4f25] mb-1.5 flex items-center gap-1.5">
            <span>🪶</span> Descripción
          </h4>
          <p id="modal-description" class="text-xs sm:text-sm text-[#1b3519] leading-relaxed font-sans font-normal"></p>
        </div>

        <!-- Bottom Action Bar with clear margin & padding -->
        <div class="pt-3 pb-1 border-t border-gray-100 flex justify-center sm:justify-end shrink-0 mt-auto">
          <button
            id="modal-btn-close"
            type="button"
            class="w-full sm:w-auto px-7 py-3 rounded-full bg-[#2b4f25] hover:bg-[#203c1b] text-white font-extrabold text-xs sm:text-sm shadow-md hover:shadow-lg transition-all cursor-pointer text-center active:scale-95"
          >
            Cerrar vista
          </button>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  // Search filtering
  const searchInput = document.getElementById('species-search') as HTMLInputElement;
  const cards = document.querySelectorAll('.species-card');

  searchInput?.addEventListener('input', (e) => {
    const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
    cards.forEach((card) => {
      const name = card.getAttribute('data-name')?.toLowerCase() || '';
      const scientific = card.getAttribute('data-scientific')?.toLowerCase() || '';
      const family = card.getAttribute('data-family')?.toLowerCase() || '';
      if (name.includes(query) || scientific.includes(query) || family.includes(query)) {
        (card as HTMLElement).style.display = 'flex';
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });
  });

  // Modal logic
  const modal = document.getElementById('bird-modal');
  const modalContent = modal?.querySelector('.modal-content');
  const modalImg = document.getElementById('modal-img') as HTMLImageElement;
  const modalTitle = document.getElementById('modal-title');
  const modalScientific = document.getElementById('modal-scientific');
  const modalFamily = document.getElementById('modal-family');
  const modalDescription = document.getElementById('modal-description');
  const modalTag = document.getElementById('modal-tag');
  const modalClose = document.getElementById('modal-close');
  const modalBtnClose = document.getElementById('modal-btn-close');

  function openModal(card: Element) {
    const name = card.getAttribute('data-name') || '';
    const scientific = card.getAttribute('data-scientific') || '';
    const family = card.getAttribute('data-family') || '';
    const tag = card.getAttribute('data-tag') || 'Ave de Chile';
    const description = card.getAttribute('data-description') || 'Información detallada disponible en el juego de cartas.';
    const imgSrc = card.getAttribute('data-img-src') || '';

    if (modalImg) {
      modalImg.src = imgSrc;
      modalImg.alt = `Ilustración de ${name}`;
    }
    if (modalTitle) modalTitle.textContent = name;
    if (modalScientific) modalScientific.textContent = scientific;
    if (modalFamily) modalFamily.textContent = family;
    if (modalTag) modalTag.textContent = tag;
    if (modalDescription) modalDescription.textContent = description;

    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
    setTimeout(() => {
      modalContent?.classList.remove('scale-95', 'opacity-0');
      modalContent?.classList.add('scale-100', 'opacity-100');
    }, 10);
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modalContent?.classList.remove('scale-100', 'opacity-100');
    modalContent?.classList.add('scale-95', 'opacity-0');
    setTimeout(() => {
      modal?.classList.remove('flex');
      modal?.classList.add('hidden');
      document.body.style.overflow = '';
    }, 200);
  }

  cards.forEach((card) => {
    card.addEventListener('click', () => openModal(card));
  });

  modalClose?.addEventListener('click', closeModal);
  modalBtnClose?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal?.classList.contains('hidden')) {
      closeModal();
    }
  });
</script>
