---
import { Image } from 'astro:assets';
import logoImg from '../assets/branding/logo.png';
import cartasImg from '../assets/branding/cartas.png';
import tejasImg from '../assets/branding/tejas.png';
import cachana1Img from '../assets/branding/cachana1.png';
import tramaBg from '../assets/branding/trama-bg.png';
import tramaFullVerde from '../assets/branding/trama-full-verde.png';
import cachanaPhotoBg from '../assets/proto_crops/cachana-photo-bg.png';
import cachanaSinFondo from '../assets/birds/sin-fondo/cachana.png';

// Hand-drawn sketch badge icons & Chilco flower
import badgeBird from '../assets/branding/badge-bird.png';
import badgePlane from '../assets/branding/badge-plane.png';
import badgeCart from '../assets/branding/badge-cart.png';
import badgeHeart from '../assets/branding/badge-heart.png';
import chilcoTrazo from '../assets/branding/chilco-trazo.png';
import selloChilcoNaranja from '../assets/branding/sello-chilco-naranja.png';
import estampilla from '../assets/branding/estampilla.png';
import logoCachando from '../assets/branding/logo-cachando.png';

import { SITE_CONFIG } from '../config/site';
---

<section id="inicio" class="relative overflow-hidden pt-6 pb-12">
  
  <!-- 1. Big Main Logo Showcase -->
  <div class="max-w-5xl mx-auto px-4 text-center py-10 sm:py-14">
    <div class="max-w-2xl sm:max-w-3xl mx-auto">
      <Image 
        src={logoImg} 
        alt="Lëpigames Logo" 
        class="w-full h-auto object-contain mx-auto max-h-60 sm:max-h-80 md:max-h-96"
        loading="eager"
      />
    </div>
  </div>

  <!-- 2. Tejas Badges Bar (High contrast light sage tejas background) -->
  <div class="w-full py-8 sm:py-10 relative overflow-hidden mt-6 mb-0 shadow-xl border-t-2 border-b-2 border-[#1b3519] bg-[#85a67c]">
    
    <!-- Tejas background texture blended seamlessly -->
    <div 
      class="absolute inset-0 bg-repeat-x bg-center opacity-95 mix-blend-multiply pointer-events-none"
      style={`background-image: url('${tejasImg.src}'); background-size: auto 100%;`}
    ></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 sm:gap-8 items-center">
        
        <!-- Badge 1: Bird Sketch Icon - Region de Los Lagos -->
        <div class="group flex items-center gap-3.5 sm:gap-4 px-1 sm:px-2">
          <div class="w-20 h-20 sm:w-24 sm:h-24 lg:w-28 lg:h-28 rounded-full border-4 sm:border-[5px] border-[#1b3519] ring-4 ring-[#1b3519]/20 bg-gradient-to-br from-[#ebf8d7] to-[#c2ea95] p-1.5 sm:p-2 flex items-center justify-center shrink-0 shadow-[0_8px_20px_rgba(0,0,0,0.3),0_0_15px_rgba(209,234,171,0.5)] group-hover:shadow-[0_12px_28px_rgba(0,0,0,0.4),0_0_25px_rgba(209,234,171,0.85)] group-hover:scale-105 transition-all duration-300 ease-out">
            <Image src={badgeBird} alt="Pajarito Trazo" class="w-full h-full object-contain transform group-hover:scale-110 group-hover:-rotate-3 transition-transform duration-300 ease-out drop-shadow-[0_2px_4px_rgba(27,53,25,0.2)]" />
          </div>
          <span class="text-white font-extrabold text-sm sm:text-base lg:text-lg leading-snug drop-shadow-[0_2px_4px_rgba(0,0,0,0.9)] group-hover:text-amber-200 transition-colors">
            Hecho en la Región de Los Lagos, Chile.
          </span>
        </div>

        <!-- Badge 2: Paper Airplane Sketch Icon - Enviamos a todo Chile -->
        <div class="group flex items-center gap-3.5 sm:gap-4 px-1 sm:px-2">
          <div class="w-20 h-20 sm:w-24 sm:h-24 lg:w-28 lg:h-28 rounded-full border-4 sm:border-[5px] border-[#1b3519] ring-4 ring-[#1b3519]/20 bg-gradient-to-br from-[#ebf8d7] to-[#c2ea95] p-1.5 sm:p-2 flex items-center justify-center shrink-0 shadow-[0_8px_20px_rgba(0,0,0,0.3),0_0_15px_rgba(209,234,171,0.5)] group-hover:shadow-[0_12px_28px_rgba(0,0,0,0.4),0_0_25px_rgba(209,234,171,0.85)] group-hover:scale-105 transition-all duration-300 ease-out">
            <Image src={badgePlane} alt="Avioncito Trazo" class="w-full h-full object-contain transform group-hover:scale-110 group-hover:rotate-3 transition-transform duration-300 ease-out drop-shadow-[0_2px_4px_rgba(27,53,25,0.2)]" />
          </div>
          <span class="text-white font-extrabold text-sm sm:text-base lg:text-lg leading-snug drop-shadow-[0_2px_4px_rgba(0,0,0,0.9)] group-hover:text-amber-200 transition-colors">
            Enviamos a todo Chile
          </span>
        </div>

        <!-- Badge 3: Shopping Cart Shield Sketch Icon - Compra segura -->
        <div class="group flex items-center gap-3.5 sm:gap-4 px-1 sm:px-2">
          <div class="w-20 h-20 sm:w-24 sm:h-24 lg:w-28 lg:h-28 rounded-full border-4 sm:border-[5px] border-[#1b3519] ring-4 ring-[#1b3519]/20 bg-gradient-to-br from-[#ebf8d7] to-[#c2ea95] p-1.5 sm:p-2 flex items-center justify-center shrink-0 shadow-[0_8px_20px_rgba(0,0,0,0.3),0_0_15px_rgba(209,234,171,0.5)] group-hover:shadow-[0_12px_28px_rgba(0,0,0,0.4),0_0_25px_rgba(209,234,171,0.85)] group-hover:scale-105 transition-all duration-300 ease-out">
            <Image src={badgeCart} alt="Carrito Escudo Trazo" class="w-full h-full object-contain transform group-hover:scale-110 group-hover:-rotate-3 transition-transform duration-300 ease-out drop-shadow-[0_2px_4px_rgba(27,53,25,0.2)]" />
          </div>
          <span class="text-white font-extrabold text-sm sm:text-base lg:text-lg leading-snug drop-shadow-[0_2px_4px_rgba(0,0,0,0.9)] group-hover:text-amber-200 transition-colors">
            Compra segura
          </span>
        </div>

        <!-- Badge 4: Heart Sketch Icon - Hecho con Amor -->
        <div class="group flex items-center gap-3.5 sm:gap-4 px-1 sm:px-2">
          <div class="w-20 h-20 sm:w-24 sm:h-24 lg:w-28 lg:h-28 rounded-full border-4 sm:border-[5px] border-[#1b3519] ring-4 ring-[#1b3519]/20 bg-gradient-to-br from-[#ebf8d7] to-[#c2ea95] p-1.5 sm:p-2 flex items-center justify-center shrink-0 shadow-[0_8px_20px_rgba(0,0,0,0.3),0_0_15px_rgba(209,234,171,0.5)] group-hover:shadow-[0_12px_28px_rgba(0,0,0,0.4),0_0_25px_rgba(209,234,171,0.85)] group-hover:scale-105 transition-all duration-300 ease-out">
            <Image src={badgeHeart} alt="Corazón Trazo" class="w-full h-full object-contain transform group-hover:scale-110 group-hover:rotate-3 transition-transform duration-300 ease-out drop-shadow-[0_2px_4px_rgba(27,53,25,0.2)]" />
          </div>
          <span class="text-white font-extrabold text-sm sm:text-base lg:text-lg leading-snug drop-shadow-[0_2px_4px_rgba(0,0,0,0.9)] group-hover:text-amber-200 transition-colors">
            Hecho con Amor
          </span>
        </div>

      </div>
    </div>
  </div>

  <!-- 3. Dark Green Section with Stamp Photo & Quote -->
  <div class="bg-[#244421] text-white py-14 px-4 sm:px-6 lg:px-8 shadow-xl mt-0">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Left: Transparent Stamp Image -->
      <div class="md:col-span-6 flex justify-center py-2">
        <div class="relative w-full max-w-lg sm:max-w-xl md:max-w-2xl lg:max-w-3xl rotate-[-2deg] hover:rotate-0 transition-transform duration-300 filter drop-shadow-[0_20px_35px_rgba(0,0,0,0.5)]">
          <Image 
            src={estampilla} 
            alt="Estampilla Lëpigames" 
            class="w-full h-auto object-contain block"
          />
        </div>
      </div>

      <!-- Right: Main Quote Banner -->
      <div class="md:col-span-6 text-center md:text-left space-y-4">
        <blockquote class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-emerald-50 leading-tight">
          "No se puede amar lo que no se conoce, ni defender lo que no se ama."
        </blockquote>
        <p class="text-xl sm:text-2xl text-emerald-200 font-serif italic text-right pr-4">
          - Lëpigames
        </p>

        <div class="pt-4 flex justify-center md:justify-start">
          <button
            type="button"
            data-open-buy-modal
            class="inline-flex items-center gap-3 bg-amber-400 hover:bg-amber-300 text-[#1b3519] font-extrabold text-base px-8 py-4 rounded-full shadow-xl hover:shadow-2xl transition-all transform hover:-translate-y-1 cursor-pointer"
          >
            <span>Quiero comprar Cachañando</span>
            <svg class="w-5 h-5 text-[#1b3519]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </button>
        </div>
      </div>

    </div>
  </div>

  <!-- 4. Playful "Conoce a CACHAÑANDO" Banner - Moderate Spacing & Semi-Transparent Slogan Card -->
  <div class="w-full my-12 px-4 overflow-hidden relative">
    <div class="max-w-6xl mx-auto text-center relative z-10 flex flex-col items-center">
      
      <!-- 1. Top Subtitle: "Conoce a" (Positioned snug above logo) -->
      <div class="-mb-3 sm:-mb-6 md:-mb-9 z-20 relative">
        <p class="text-2xl sm:text-4xl font-serif font-bold text-[#1b3519] tracking-tight">
          Conoce a
        </p>
      </div>

      <!-- 2. Main Title Logo Image: Logocachañando.png -->
      <div class="relative w-full max-w-3xl sm:max-w-4xl md:max-w-5xl mx-auto z-10 px-2">
        <Image 
          src={logoCachando} 
          alt="Cachañando - El Juego de las Aves de Chile" 
          class="w-full h-auto object-contain mx-auto drop-shadow-md"
        />
      </div>

      <!-- 3. PROTAGONIST BIRD IMAGE (REDUCED SIZE & GREATER TOP OVERLAP WITH LOGO) -->
      <div class="relative max-w-xs sm:max-w-sm md:max-w-md lg:max-w-lg mx-auto -mt-16 sm:-mt-24 md:-mt-36 lg:-mt-44 z-10 pointer-events-none">
        <Image 
          src={cachana1Img} 
          alt="Cachaña - Protagonista del juego" 
          class="w-full h-auto object-contain mx-auto drop-shadow-[0_15px_25px_rgba(0,0,0,0.2)]"
        />
      </div>

      <!-- 4. Subtitle Phrase / Slogan in Semi-Transparent Card Badge -->
      <div class="-mt-16 sm:-mt-20 md:-mt-28 lg:-mt-32 mb-6 sm:mb-8 z-20 relative">
        <div class="inline-flex items-center gap-2 bg-[#1b3519]/90 backdrop-blur-md px-6 sm:px-8 py-3 rounded-full border border-emerald-500/30 shadow-xl">
          <p class="text-base sm:text-2xl md:text-3xl font-black uppercase tracking-widest text-amber-300">
            EL JUEGO DE LAS AVES DE CHILE
          </p>
        </div>
      </div>

      <!-- 5. 4 Informative Cards with subtle green pattern background & translucency -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5 text-[#1b3519] text-center max-w-6xl mx-auto relative z-20 w-full -mt-2 sm:-mt-4">
        
        <!-- Column 1 -->
        <div class="relative overflow-hidden bg-white/80 backdrop-blur-md p-5 sm:p-6 rounded-3xl border border-[#2b4f25]/25 shadow-lg hover:shadow-xl transition-all flex flex-col justify-center group">
          <div 
            class="absolute inset-0 bg-repeat bg-center opacity-20 mix-blend-multiply pointer-events-none rounded-3xl transition-opacity group-hover:opacity-30"
            style={`background-image: url('${tramaFullVerde.src}'); background-size: 180px auto;`}
          ></div>
          <p class="relative z-10 text-xs sm:text-sm md:text-base leading-relaxed font-sans font-medium text-[#1b3519]">
            El juego se compone de <strong class="text-[#2b4f25] font-bold">31 especies</strong> que albergan representantes de cada familia de aves en Chile. Cada ave ha sido seleccionada para familiarizar al jugador con la diversidad de nuestro patrimonio natural.
          </p>
        </div>

        <!-- Column 2 -->
        <div class="relative overflow-hidden bg-white/80 backdrop-blur-md p-5 sm:p-6 rounded-3xl border border-[#2b4f25]/25 shadow-lg hover:shadow-xl transition-all flex flex-col justify-center group">
          <div 
            class="absolute inset-0 bg-repeat bg-center opacity-20 mix-blend-multiply pointer-events-none rounded-3xl transition-opacity group-hover:opacity-30"
            style={`background-image: url('${tramaFullVerde.src}'); background-size: 180px auto;`}
          ></div>
          <p class="relative z-10 text-xs sm:text-sm md:text-base leading-relaxed font-sans font-medium text-[#1b3519]">
            Más que un juego, es una <strong class="text-[#2b4f25] font-bold">invitación a la pausa y al reconocimiento</strong> de nuestro patrimonio alado a través de la observación profunda y la memoria visual.
          </p>
        </div>

        <!-- Column 3 -->
        <div class="relative overflow-hidden bg-white/80 backdrop-blur-md p-5 sm:p-6 rounded-3xl border border-[#2b4f25]/25 shadow-lg hover:shadow-xl transition-all flex flex-col justify-center group">
          <div 
            class="absolute inset-0 bg-repeat bg-center opacity-20 mix-blend-multiply pointer-events-none rounded-3xl transition-opacity group-hover:opacity-30"
            style={`background-image: url('${tramaFullVerde.src}'); background-size: 180px auto;`}
          ></div>
          <p class="relative z-10 text-xs sm:text-sm md:text-base leading-relaxed font-sans font-medium text-[#1b3519]">
            Las cachañas (<em>Enicognathus ferrugineus</em>) quienes le dan nombre a nuestro primer juego, se caracterizan por ser aves <strong class="text-[#2b4f25] font-bold">gregarias, bulliciosas y sobre todo curiosas</strong>.
          </p>
        </div>

        <!-- Column 4 -->
        <div class="relative overflow-hidden bg-white/80 backdrop-blur-md p-5 sm:p-6 rounded-3xl border border-[#2b4f25]/25 shadow-lg hover:shadow-xl transition-all flex flex-col justify-center group">
          <div 
            class="absolute inset-0 bg-repeat bg-center opacity-20 mix-blend-multiply pointer-events-none rounded-3xl transition-opacity group-hover:opacity-30"
            style={`background-image: url('${tramaFullVerde.src}'); background-size: 180px auto;`}
          ></div>
          <p class="relative z-10 text-xs sm:text-sm md:text-base leading-relaxed font-sans font-medium text-[#1b3519]">
            Tal como las cachañas, este juego celebra la <strong class="text-[#2b4f25] font-bold">naturaleza gregaria</strong> del ser humano, el asombro compartido y la alegría vivida en cada partida.
          </p>
        </div>

      </div>

    </div>
  </div>

</section>
