---
import { Image } from "astro:assets";
import cartasImg from "../assets/branding/cartas.png";
import logoImg from "../assets/branding/logo.png";
import { SITE_CONFIG } from "../config/site";

const whatsappUrl = `https://wa.me/${SITE_CONFIG.whatsAppNumber.replace("+", "")}?text=${encodeURIComponent(SITE_CONFIG.whatsAppMessage)}`;
---

<!-- Global Buy Modal -->
<div
  id="buy-modal"
  class="fixed inset-0 z-[100] hidden items-center justify-center p-4 sm:p-6 overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-labelledby="buy-modal-title"
>
  <!-- Backdrop Blur Overlay -->
  <div
    id="buy-modal-backdrop"
    class="fixed inset-0 bg-emerald-950/75 backdrop-blur-md transition-opacity duration-300 opacity-0 cursor-pointer"
  >
  </div>

  <!-- Modal Container Card -->
  <div
    id="buy-modal-card"
    class="relative w-full max-w-lg bg-[#fcfbf7] rounded-3xl shadow-2xl border border-emerald-800/20 overflow-hidden transform scale-95 transition-all duration-300 z-10 opacity-0 my-auto"
  >
    <!-- Cinta Gigante 'Próximamente' que atraviesa todo el modal -->
    <div
      class="absolute inset-0 flex items-center justify-center pointer-events-none z-30 overflow-hidden"
    >
      <div
        class="w-[150%] -rotate-12 bg-gradient-to-r from-amber-500 via-amber-300 to-amber-500 py-3 sm:py-4 shadow-[0_20px_40px_rgba(0,0,0,0.45)] border-y-4 border-amber-100/90 flex items-center justify-center gap-3 sm:gap-6 text-stone-950 font-black text-xl sm:text-3xl tracking-[0.22em] uppercase select-none ring-2 ring-amber-600/30"
      >
        <span class="text-stone-900/60 text-sm sm:text-lg">★</span>
        <span>PRÓXIMAMENTE</span>
        <span class="text-stone-900/60 text-sm sm:text-lg">★</span>
      </div>
    </div>

    <!-- Top Header Pattern Banner -->
    <div
      class="relative bg-gradient-to-r from-[#244421] via-[#2b4f25] to-[#1b3519] text-white p-6 pb-7"
    >
      <button
        id="buy-modal-close"
        type="button"
        class="absolute top-4 right-4 text-emerald-200/80 hover:text-white bg-black/20 hover:bg-black/40 w-9 h-9 rounded-full flex items-center justify-center transition-colors focus:outline-none z-20"
        aria-label="Cerrar modal"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2.5"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>

      <div class="flex items-center gap-3 mb-2">
        <span
          class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-400/20 text-amber-300 font-extrabold text-[11px] uppercase tracking-wider border border-amber-400/30"
        >
          <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
          Próximo Lanzamiento
        </span>
      </div>

      <h3
        id="buy-modal-title"
        class="text-2xl sm:text-3xl font-serif font-extrabold text-white leading-tight"
      >
        ¡Lleva el juego <span class="text-amber-300">Cachañando</span>!
      </h3>
      <p class="text-xs sm:text-sm text-emerald-100/90 mt-1 font-sans">
        El juego de cartas que conecta a la familia con el patrimonio alado de
        Chile.
      </p>
    </div>

    <!-- Modal Body Content -->
    <div class="p-6 sm:p-7 space-y-6">
      <!-- Product Preview Card -->
      <div
        class="flex flex-col sm:flex-row items-center gap-5 p-4 rounded-2xl bg-emerald-950/5 border border-emerald-900/10"
      >
        <div
          class="w-28 h-28 sm:w-32 sm:h-32 rounded-xl bg-white p-2 shadow-md shrink-0 flex items-center justify-center rotate-[-2deg]"
        >
          <Image
            src={cartasImg}
            alt="Mazo de cartas Cachañando"
            class="w-full h-full object-cover rounded-lg"
          />
        </div>
        <div class="space-y-1.5 text-center sm:text-left flex-1">
          <span
            class="text-xs font-bold text-emerald-800 uppercase tracking-wider"
            >Mazo Principal</span
          >
          <h4 class="text-lg font-bold text-emerald-950 leading-snug">
            Juego de Cartas Cachañando
          </h4>
          <p class="text-xs text-emerald-900/70">
            31 especies ilustradas • 6 variantes de juego • Caja rígida
          </p>
          <div
            class="pt-1 flex items-baseline justify-center sm:justify-start gap-2"
          >
            <span class="text-2xl font-black text-[#2b4f25]"
              >{SITE_CONFIG.price}</span
            >
            <span class="text-xs text-emerald-800/70 font-semibold"
              >CLP + Envío</span
            >
          </div>
        </div>
      </div>

      <!-- Highlights List -->
      <ul class="space-y-2.5 text-xs sm:text-sm text-emerald-950">
        <li class="flex items-start gap-2.5">
          <div
            class="w-5 h-5 rounded-full bg-emerald-700/15 text-emerald-800 flex items-center justify-center shrink-0 mt-0.5"
          >
            <svg
              class="w-3.5 h-3.5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M5 13l4 4L19 7"></path></svg
            >
          </div>
          <span
            ><strong>Envíos a todo Chile</strong> desde la Región de Los Lagos.</span
          >
        </li>
        <li class="flex items-start gap-2.5">
          <div
            class="w-5 h-5 rounded-full bg-emerald-700/15 text-emerald-800 flex items-center justify-center shrink-0 mt-0.5"
          >
            <svg
              class="w-3.5 h-3.5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M5 13l4 4L19 7"></path></svg
            >
          </div>
          <span
            ><strong>Pago seguro y rápido</strong> con tarjetas de débito, crédito
            o transferencia bancaria.</span
          >
        </li>
        <li class="flex items-start gap-2.5">
          <div
            class="w-5 h-5 rounded-full bg-emerald-700/15 text-emerald-800 flex items-center justify-center shrink-0 mt-0.5"
          >
            <svg
              class="w-3.5 h-3.5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M5 13l4 4L19 7"></path></svg
            >
          </div>
          <span
            ><strong>Apoyo a conservación</strong>: Tu compra apoya programas de
            educación ambiental en escuelas del sur.</span
          >
        </li>
      </ul>

      <!-- Action Buttons -->
      <div class="space-y-3 pt-2">
        <!-- Disabled Primary Checkout Button -->
        <button
          type="button"
          disabled
          aria-disabled="true"
          class="w-full flex items-center justify-center gap-3 bg-stone-200 text-stone-500 font-extrabold text-base py-3.5 px-6 rounded-2xl cursor-not-allowed shadow-none border border-stone-300 select-none opacity-85 transition-none"
        >
          <svg
            class="w-6 h-6 fill-current text-stone-400 shrink-0"
            viewBox="0 0 24 24"
          >
            <path
              d="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z"
            ></path>
          </svg>
          <span>Comprar Cachañando</span>
          <span
            class="text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-stone-300 text-stone-600 uppercase tracking-wider"
          >
            Próximamente
          </span>
        </button>

        <!-- Secondary WhatsApp Consultation Button -->
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full flex items-center justify-center gap-2.5 bg-emerald-900/10 hover:bg-emerald-900/20 text-[#1b3519] font-bold text-sm py-3 px-5 rounded-2xl border border-emerald-900/20 transition-colors"
        >
          <svg
            class="w-5 h-5 text-emerald-700 shrink-0"
            fill="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-1.002 3.66 3.745-.983z"
            ></path>
          </svg>
          <span>¿Tienes dudas o compras al por mayor? Habla por WhatsApp</span>
        </a>
      </div>
    </div>

    <!-- Modal Footer Note -->
    <div
      class="bg-emerald-950/5 px-6 py-3 border-t border-emerald-900/10 text-center text-[11px] text-emerald-900/70 font-medium"
    >
      🔒 Transacción y datos procesados de forma 100% segura
    </div>
  </div>
</div>

<script>
  function setupBuyModal() {
    const modal = document.getElementById("buy-modal");
    const backdrop = document.getElementById("buy-modal-backdrop");
    const card = document.getElementById("buy-modal-card");
    const closeBtn = document.getElementById("buy-modal-close");

    if (!modal || !backdrop || !card) return;

    function openModal(e?: Event) {
      if (e) e.preventDefault();
      modal?.classList.remove("hidden");
      modal?.classList.add("flex");

      // Force repaint for animation
      setTimeout(() => {
        backdrop?.classList.remove("opacity-0");
        card?.classList.remove("scale-95", "opacity-0");
        card?.classList.add("scale-100", "opacity-100");
      }, 10);

      document.body.style.overflow = "hidden";
    }

    function closeModal() {
      backdrop?.classList.add("opacity-0");
      card?.classList.remove("scale-100", "opacity-100");
      card?.classList.add("scale-95", "opacity-0");

      setTimeout(() => {
        modal?.classList.remove("flex");
        modal?.classList.add("hidden");
        document.body.style.overflow = "";
      }, 300);
    }

    // Attach open handler to all elements with data-buy-modal trigger
    document.querySelectorAll("[data-open-buy-modal]").forEach((trigger) => {
      trigger.addEventListener("click", openModal);
    });

    closeBtn?.addEventListener("click", closeModal);
    backdrop?.addEventListener("click", closeModal);

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !modal?.classList.contains("hidden")) {
        closeModal();
      }
    });
  }

  // Initialize on load & DOMContentLoaded
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupBuyModal);
  } else {
    setupBuyModal();
  }
</script>
