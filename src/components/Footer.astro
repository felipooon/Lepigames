---
import { Image } from "astro:assets";
import logoImg from "../assets/branding/logo.png";
import { SITE_CONFIG } from "../config/site";
---

<footer
  class="bg-emerald-950 text-emerald-100 border-t border-emerald-900/60 pt-16 pb-12"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div
      class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-12 border-b border-emerald-900/60"
    >
      <!-- Brand Info -->
      <div class="md:col-span-5 space-y-4">
        <div
          class="w-48 h-auto bg-white/90 p-2.5 rounded-2xl shadow-sm inline-block"
        >
          <Image
            src={logoImg}
            alt="Lëpigames Logo"
            class="w-full h-auto object-contain max-h-12"
          />
        </div>
        <p class="text-sm text-emerald-200/80 leading-relaxed max-w-sm">
          Lëpigames. Conectando generaciones a través de las aves, el arte, la
          ciencia y la educación desde la Región de Los Lagos, Chile.
        </p>
        <div
          class="flex items-center gap-2 text-xs text-amber-300 font-semibold"
        >
          <svg
            class="w-4 h-4 text-emerald-400"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
            ></path><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg
          >
          <span>{SITE_CONFIG.location}</span>
        </div>
      </div>

      <!-- Quick Nav Links -->
      <div class="md:col-span-3 space-y-3">
        <h4 class="text-sm font-extrabold text-white uppercase tracking-wider">
          Navegación
        </h4>
        <ul class="space-y-2 text-sm text-emerald-200/70">
          <li>
            <a href="#inicio" class="hover:text-amber-300 transition-colors"
              >Inicio</a
            >
          </li>
          <li>
            <a href="#el-juego" class="hover:text-amber-300 transition-colors"
              >El Juego Cachañando</a
            >
          </li>
          <li>
            <a href="#especies" class="hover:text-amber-300 transition-colors"
              >Las 31 Especies</a
            >
          </li>
          <li>
            <a href="#nosotros" class="hover:text-amber-300 transition-colors"
              >Nuestra Historia</a
            >
          </li>
          <li>
            <a href="#educacion" class="hover:text-amber-300 transition-colors"
              >Proyectos Educativos</a
            >
          </li>
          <li>
            <a
              href="#conservacion"
              class="hover:text-amber-300 transition-colors"
              >Apoyo a Conservación</a
            >
          </li>
          <li>
            <a href="#faq" class="hover:text-amber-300 transition-colors"
              >Preguntas Frecuentes</a
            >
          </li>
        </ul>
      </div>

      <!-- Social & Direct Channels -->
      <div class="md:col-span-4 space-y-4">
        <h4 class="text-sm font-extrabold text-white uppercase tracking-wider">
          Canales Oficiales
        </h4>
        <div class="space-y-3">
          <!-- Instagram Link -->
          <a
            href={SITE_CONFIG.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 p-3 rounded-2xl bg-emerald-900/40 hover:bg-emerald-900 border border-emerald-800/60 text-sm font-semibold text-emerald-100 transition-colors"
          >
            <div
              class="w-8 h-8 rounded-xl bg-gradient-to-tr from-amber-500 to-rose-500 flex items-center justify-center text-white shrink-0"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
                ><path
                  d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
                ></path></svg
              >
            </div>
            <div>
              <span class="block text-xs text-emerald-300"
                >Síguenos en Instagram</span
              >
              <span class="font-bold text-white"
                >{SITE_CONFIG.instagramHandle}</span
              >
            </div>
          </a>

          <!-- WhatsApp Link -->
          <a
            href={`https://wa.me/${SITE_CONFIG.whatsAppNumber.replace(/\D/g, "")}?text=${encodeURIComponent(SITE_CONFIG.whatsAppMessage)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 p-3 rounded-2xl bg-emerald-900/40 hover:bg-emerald-900 border border-emerald-800/60 text-sm font-semibold text-emerald-100 transition-colors"
          >
            <div
              class="w-8 h-8 rounded-xl bg-emerald-600 flex items-center justify-center text-white shrink-0"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
                ><path
                  d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-1.002 3.66 3.745-.983z"
                ></path></svg
              >
            </div>
            <div>
              <span class="block text-xs text-emerald-300"
                >Contacto Directo</span
              >
              <span class="font-bold text-white">WhatsApp Lëpigames</span>
              <span class="block text-[11px] text-emerald-200/80 font-mono mt-0.5">{SITE_CONFIG.whatsAppNumber}</span>
            </div>
          </a>
          <!-- Email Link -->
          <a
            href={`mailto:${SITE_CONFIG.email}`}
            class="flex items-center gap-3 p-3 rounded-2xl bg-emerald-900/40 hover:bg-emerald-900 border border-emerald-800/60 text-sm font-semibold text-emerald-100 transition-colors"
          >
            <div
              class="w-8 h-8 rounded-xl bg-amber-500/20 text-amber-300 flex items-center justify-center shrink-0 border border-amber-400/30"
            >
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
            </div>
            <div>
              <span class="block text-xs text-emerald-300"
                >Correo Electrónico</span
              >
              <span class="font-bold text-white">{SITE_CONFIG.email}</span>
            </div>
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div
      class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-emerald-200/60 gap-4 text-center sm:text-left"
    >
      <p>
        © {new Date().getFullYear()} Lëpigames. Todos los derechos reservados.
      </p>
      <p
        class="flex items-center gap-1.5 text-emerald-400/40 hover:text-emerald-300/80 transition-colors text-xs font-normal"
      >
        <span>🪶</span>
        <span>Desarrollado por Felipe</span>
      </p>
    </div>
  </div>
</footer>
