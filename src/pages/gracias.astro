---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import logoImg from '../assets/branding/logo.png';
import cachanaSinFondo from '../assets/birds/sin-fondo/cachana.png';
import { SITE_CONFIG } from '../config/site';

const waMessage = "¡Hola Lëpigames! Acabo de realizar la compra del juego Cachañando. Adjunto mi comprobante para coordinar los datos de despacho.";
const waUrl = `https://wa.me/${SITE_CONFIG.whatsAppNumber.replace('+', '')}?text=${encodeURIComponent(waMessage)}`;
---

<Layout 
  title={`¡Gracias por tu compra! | ${SITE_CONFIG.name}`}
  description="Confirmación de pedido del juego Cachañando. Coordina tu despacho directamente por WhatsApp."
>
  <main class="min-h-screen flex items-center justify-center py-16 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-[#fcfbf7] via-[#f7f3e9] to-[#fcfbf7] relative overflow-hidden">
    
    <div class="max-w-xl w-full text-center space-y-8 relative z-10 bg-white p-8 sm:p-12 rounded-3xl border border-emerald-900/10 shadow-2xl">
      
      <!-- Brand Logo -->
      <div class="flex justify-center">
        <div class="w-48 sm:w-56 h-auto">
          <Image src={logoImg} alt="Lëpigames Logo" class="w-full h-auto object-contain max-h-16" />
        </div>
      </div>

      <!-- Bird Illustration Badge -->
      <div class="relative w-32 h-32 mx-auto">
        <div class="absolute inset-0 bg-emerald-100 rounded-full blur-xl"></div>
        <div class="relative w-full h-full flex items-center justify-center animate-float">
          <Image src={cachanaSinFondo} alt="Cachaña de Agradecimiento" class="w-28 h-auto object-contain drop-shadow-lg" />
        </div>
      </div>

      <!-- Thank You Message -->
      <div class="space-y-3">
        <span class="inline-block px-3 py-1 rounded-full bg-emerald-100 text-emerald-900 font-extrabold text-xs uppercase tracking-widest">
          ¡Pago Recibido con Éxito!
        </span>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-emerald-950">
          ¡Gracias por sumarte a <span class="text-emerald-700">Cachañando</span>!
        </h1>
        <p class="text-base text-emerald-900/80 leading-relaxed">
          Tu compra apoya directamente el conocimiento, educación y conservación de las aves en la Región de Los Lagos.
        </p>
      </div>

      <!-- Instructions Box -->
      <div class="p-6 rounded-2xl bg-emerald-50 border border-emerald-900/10 text-left space-y-3">
        <h2 class="font-extrabold text-sm uppercase tracking-wider text-emerald-950 flex items-center gap-2">
          <svg class="w-5 h-5 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          Siguiente paso: Coordinar tu despacho
        </h2>
        <p class="text-xs sm:text-sm text-emerald-900/80 leading-relaxed">
          Para enviarte tu paquete lo antes posible y proporcionarte tu número de seguimiento (Starken, Chilexpress o Correos de Chile), haz clic en el botón a continuación para escribirnos por WhatsApp con tu dirección o comprobante.
        </p>
      </div>

      <!-- WhatsApp CTA -->
      <div class="space-y-3 pt-2">
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full inline-flex items-center justify-center gap-3 bg-emerald-700 hover:bg-emerald-800 text-white font-extrabold text-base py-4 px-6 rounded-2xl shadow-xl hover:shadow-2xl transition-all transform hover:-translate-y-0.5 active:translate-y-0"
        >
          <svg class="w-6 h-6 text-emerald-300" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-1.002 3.66 3.745-.983z"/></svg>
          <span>Coordinar despacho por WhatsApp</span>
        </a>

        <a
          href="/"
          class="block text-xs font-bold text-emerald-900/60 hover:text-emerald-950 transition-colors pt-2"
        >
          ← Volver a la página principal
        </a>
      </div>

    </div>

  </main>
</Layout>
